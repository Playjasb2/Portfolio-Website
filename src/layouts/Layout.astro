---
import "../styles/global.css";
import "@fontsource/outfit/400.css";
import "@fontsource/outfit/500.css";
import "@fontsource/outfit/600.css";
import "@fontsource/outfit/700.css";
import { ClientRouter } from "astro:transitions";
import FontPreloader from "../components/Astro/FontPreloader.astro";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  profileImage?: string;
}

const {
  title,
  description = "Jasmeet Brar is a Senior Software Engineer focused on clean architecture, developer tooling, performance, and maintainable systems.",
  noindex = false,
  profileImage,
} = Astro.props;

const siteUrl = new URL(Astro.site?.href ?? "https://www.jasmeetbrar.com");
const homeUrl = new URL("/", siteUrl).href;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImageUrl = new URL("/og.png", siteUrl).href;
const profileImageUrl = profileImage ? new URL(profileImage, siteUrl).href : undefined;
const personId = `${homeUrl}#person`;
const websiteId = `${homeUrl}#website`;
const profilePageId = `${homeUrl}#profile-page`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: homeUrl,
      name: "Jasmeet Brar",
      description,
      inLanguage: "en-CA",
      creator: { "@id": personId },
    },
    {
      "@type": "ProfilePage",
      "@id": profilePageId,
      url: homeUrl,
      name: "Jasmeet Brar | Senior Software Engineer",
      description,
      inLanguage: "en-CA",
      isPartOf: { "@id": websiteId },
      mainEntity: { "@id": personId },
      ...(profileImageUrl && {
        primaryImageOfPage: {
          "@type": "ImageObject",
          url: profileImageUrl,
          contentUrl: profileImageUrl,
          caption: "Jasmeet Brar",
        },
      }),
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "Jasmeet Brar",
      url: homeUrl,
      jobTitle: "Senior Software Engineer",
      description,
      mainEntityOfPage: { "@id": profilePageId },
      ...(profileImageUrl && {
        image: {
          "@type": "ImageObject",
          url: profileImageUrl,
          contentUrl: profileImageUrl,
          caption: "Jasmeet Brar",
        },
      }),
      worksFor: {
        "@type": "Organization",
        name: "AMD Inc.",
      },
      sameAs: [
        "https://github.com/Playjasb2",
        "https://www.linkedin.com/in/jasmeetbrar/",
        "https://stackoverflow.com/users/6206683/jasmeet-brar",
      ],
      knowsAbout: [
        "Clean architecture",
        "Systems design",
        "Developer tooling",
        "Performance",
        "Automation",
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <meta name="author" content="Jasmeet Brar" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta name="generator" content={Astro.generator} />

    <!-- Structured Data -->
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Fonts: Outfit (Local & Preloaded) -->
    <FontPreloader />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Jasmeet Brar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jasmeet Brar, Senior Software Engineer" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Jasmeet Brar, Senior Software Engineer" />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body
    class="bg-background text-text selection:bg-primary/30 min-h-screen flex flex-col overflow-x-clip antialiased"
  >
    <slot />
  </body>
</html>
